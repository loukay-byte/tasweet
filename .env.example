# Copy to .env.local for local development, and set the same values in Vercel.
# Only NEXT_PUBLIC_* values are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Pre-launch lock. While both are set, every page asks for this username and
# password, and search engines are told not to index the site.
# Delete both (and redeploy) to go live. Server-only: never prefix with NEXT_PUBLIC_.
SITE_USERNAME=
SITE_PASSWORD=
